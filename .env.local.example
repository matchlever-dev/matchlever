# Supabase project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq (resume sanitize) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional override (default: llama-3.3-70b-versatile)
# Faster free-tier option: llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek V3 (reference authenticity) — https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# Resend (reference invite emails) — https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=MatchLever <onboarding@resend.dev>
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://www.matchlever.com
