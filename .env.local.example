# Supabase project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: run migrations from the repo (npm run db:query -- supabase/migrations/....sql)
# Supabase Dashboard → Project Settings → Database → connection string (URI) or password
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=your-database-password

# Groq (resume sanitize) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional override. llama-3.3-70b-versatile was retired by Groq on 2026-08-16.
# Default: openai/gpt-oss-120b  |  lighter option: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# DeepSeek V3 (reference authenticity) — https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# Optional LinkedIn enrichment provider for full referrer profile checks
# (connections, jobs, photo, activity). POST { linkedinUrl } → JSON with
# connections / experiences / hasPhoto / lastActivityAt.
# Without this, MatchLever uses public probes + structural gates.
# LINKEDIN_ENRICHMENT_URL=https://your-enrichment-api.example/v1/profile
# LINKEDIN_ENRICHMENT_API_KEY=your-enrichment-api-key

# Resend (reference invite emails) — https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=MatchLever <onboarding@resend.dev>
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://www.matchlever.com

# Vercel Cron (weekly incomplete-profile reminders). Required in production.
# Vercel sends Authorization: Bearer $CRON_SECRET to /api/cron/*
# CRON_SECRET=generate-with-openssl-rand-hex-32

# Optional: Admin Dashboard visitor volume via Vercel Web Analytics API.
# Enable Web Analytics on the Vercel project, then set:
# VERCEL_API_TOKEN=...
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...
# Until configured, visitor volume falls back to contacts + new signups.

# Optional dedicated secret for unsubscribe links (falls back to CRON_SECRET /
# SUPABASE_SERVICE_ROLE_KEY). Apply supabase/migrations/20260813000000_email_unsubscribes.sql
# EMAIL_UNSUBSCRIBE_SECRET=generate-with-openssl-rand-hex-32
